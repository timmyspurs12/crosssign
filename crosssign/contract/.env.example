# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` — it is git-ignored.

# Private key of the deployer wallet (0x-prefixed, no 0x also fine).
# The deployer becomes the OWNER of both contracts.
# ⚠️ Use a throwaway buildathon key, never a real wallet.
PRIVATE_KEY=

# Arbitrum RPC endpoint. Defaults to the public Arbitrum Sepolia RPC.
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Human label stored in the verification record (optional).
DESTINATION_NETWORK=arbitrum-sepolia

# Set only if you want the registry's initial issuer to be a specific address.
# If empty, the deploy script uses the deployer's own address.
ISSUER_ADDRESS=
