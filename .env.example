# CrossSign web app — copy to `.env.local` and fill in.
#
# These are BUILD-TIME values: NEXT_PUBLIC_* is inlined by Next.js, so a change
# requires `npm run build` (and a redeploy on Vercel) to take effect.
#
# ⚠️ Never leave the addresses at the zero address: a transaction sent to 0x0
# mines, reports "Success", emits no logs and mints nothing. CrossSign refuses
# to build a challenge or submit while they are unset.

# Deployed Stylus contracts (contract/deployments/sepolia.json)
NEXT_PUBLIC_VERIFIER_ADDRESS=0x39db2d89ceb5b3f312c7a37459c39da05e251d2e
NEXT_PUBLIC_REGISTRY_ADDRESS=0x2862cbdc406546e457a8eb493708613fd9f7c8ac

# Destination chain (421614 = Arbitrum Sepolia)
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_ARBITRUM_RPC=https://sepolia-rollup.arbitrum.io/rpc
